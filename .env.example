# --- Jev (TypeSafe decision model) ---
# Jev is available on OpenRouter — no separate TypeSafe account needed.
# Set OPENROUTER_API_KEY and SkillRouter will use it automatically.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Alternative: use TypeSafe directly (if you have a TypeSafe account)
# TYPESAFE_API_KEY=your_typesafe_api_key_here

# --- LLM baseline (evaluate.py only) ---
# Only needed for scripts/evaluate.py --provider anthropic / --provider openai
# The default baseline already uses OpenRouter (same key as above — no extra key needed).
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
